# Public SDK configuration, not administrative credentials.
# Use client/.env.local for local development; it is ignored by git.
# Set separate Vercel Preview and Production values, with distinct projects.
VITE_DATA_BACKEND=firebase
VITE_FIREBASE_USE_EMULATORS=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Required by the Vercel build guard. Not exposed to browser code.
FIREBASE_PRODUCTION_PROJECT_ID=
# Production MUST NOT set VITE_DEMO.
