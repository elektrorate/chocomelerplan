{
  "name": "openfamily",
  "version": "1.8.2",
  "description": "Application open source pour gérer la vie de famille",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "build:shared": "cd shared && npm run build",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "build:site": "node scripts/build-site.mjs",
    "check:public": "node scripts/check-public-safe.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "smoke:api": "bash ./scripts/smoke-api.sh",
    "install:all": "npm install && cd client && npm install && cd ../server && npm install && cd ../shared && npm install",
    "check:i18n": "cd client && npm run check:i18n",
    "dev:firebase": "npm run dev --workspace=@openfamily/client -- --mode emulator --host 127.0.0.1 --port 6513 --strictPort",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-chocomelerplan",
    "test:firebase:rules": "node --test firebase/test/rules.test.mjs",
    "test:firebase": "firebase emulators:exec --only auth,firestore --project demo-chocomelerplan \"node --test firebase/test/rules.test.mjs\"",
    "build:vercel": "node scripts/check-firebase-build.mjs && npm run build:shared && npm run build:client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase-tools": "15.32.1"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "serialize-javascript": "7.0.5",
    "@babel/core": "^7.29.6",
    "esbuild": "^0.28.1",
    "body-parser": "^1.20.6",
    "qs": "^6.16.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
